<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SeraphLeveling</RootNamespace>
    <AssemblyName>SeraphLeveling</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference the Vintage Story DLLs (uses APPDATA env var for portability) -->
    <Reference Include="VintagestoryAPI">
      <HintPath>$(APPDATA)\Vintagestory\VintagestoryAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VintagestoryLib">
      <HintPath>$(APPDATA)\Vintagestory\VintagestoryLib.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VSSurvivalMod">
      <HintPath>$(APPDATA)\Vintagestory\Mods\VSSurvivalMod.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(APPDATA)\Vintagestory\Lib\Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(APPDATA)\Vintagestory\Lib\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(APPDATA)\Vintagestory\Lib\protobuf-net.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="Package" AfterTargets="PostBuildEvent">
    <!-- Read version from modinfo.json -->
    <PropertyGroup>
      <ModInfoContent>$([System.IO.File]::ReadAllText('$(ProjectDir)modinfo.json'))</ModInfoContent>
      <ModVersion>$([System.Text.RegularExpressions.Regex]::Match($(ModInfoContent), '"version":\s*"([^"]+)"').Groups[1].Value)</ModVersion>
      <ModZipName>SeraphLeveling_$(ModVersion).zip</ModZipName>
      <ModOutDir>$(ProjectDir)bin\$(Configuration)\$(TargetFramework)</ModOutDir>
    </PropertyGroup>
    <ItemGroup>
      <PackageFiles Include="$(TargetPath)" />
      <PackageFiles Include="modinfo.json" />
      <AssetFiles Include="$(ProjectDir)assets\**\*.*" />
      <!-- Old versioned zips to clean so stale duplicates don't pile up and load
           alongside the current one (same modid = the game loads an arbitrary one).
           The trailing underscore means this does NOT match the separate
           SeraphLevelingExperimental_*.zip mod. -->
      <OldZipsBin Include="$(ModOutDir)\SeraphLeveling_*.zip" />
      <OldZipsDeploy Include="$(APPDATA)\VintagestoryData\Mods\SeraphLeveling_*.zip" />
    </ItemGroup>
    <!-- 1. Clean old bin zips (bin is never locked) and build the new zip -->
    <Delete Files="@(OldZipsBin)" />
    <Copy SourceFiles="@(PackageFiles)" DestinationFolder="$(ModOutDir)\mod\" />
    <Copy SourceFiles="@(AssetFiles)" DestinationFiles="@(AssetFiles->'$(ModOutDir)\mod\assets\%(RecursiveDir)%(Filename)%(Extension)')" />
    <ZipDirectory SourceDirectory="$(ModOutDir)\mod\" DestinationFile="$(ModOutDir)\$(ModZipName)" Overwrite="true" />
    <!-- 2. Remove stale deployed versions (best-effort; never fail the build if the
         game is running and holds a lock), then deploy the freshly built zip. -->
    <Delete Files="@(OldZipsDeploy)" ContinueOnError="true" />
    <Copy SourceFiles="$(ModOutDir)\$(ModZipName)" DestinationFolder="$(APPDATA)\VintagestoryData\Mods\" />
    <Message Importance="high" Text="Deployed $(ModZipName) to $(APPDATA)\VintagestoryData\Mods\" />
  </Target>

</Project>
